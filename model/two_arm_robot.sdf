<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="arm_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Two-Arm Robot ===== -->
    <model name="two_arm_robot" canonical_link="base">
      <pose relative_to="world">0 0 0 0 0 0</pose>

      <!-- Base: fixed mount plate on ground -->
      <link name="base">
        <pose relative_to="__model__">0 0 0.25 0 0 0</pose>
        <inertial>
          <mass>100</mass>
          <inertia>
            <ixx>10</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>10</iyy><iyz>0</iyz>
            <izz>10</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.0 1.0 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>1.0 1.0 0.5</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Anchor the mount while keeping the articulated links dynamic. -->
      <joint name="world_to_base" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>

      <!-- Vertical arm: pillar rising from base -->
      <link name="vertical_arm">
        <pose relative_to="base">0 0 0.5 0 0 0</pose>
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>0.42</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.42</iyy><iyz>0</iyz>
            <izz>0.05</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 0.15 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 0.15 1.0</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Fixed joint: base → vertical arm -->
      <joint name="base_to_vertical" type="fixed">
        <parent>base</parent>
        <child>vertical_arm</child>
      </joint>

      <!-- Horizontal arm: beam extending outward, slides up/down the vertical arm -->
      <link name="horizontal_arm">
        <pose relative_to="vertical_arm">0 0 0 0 0 0</pose>
        <inertial>
          <mass>5</mass>
          <inertia>
            <ixx>0.17</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.02</iyy><iyz>0</iyz>
            <izz>0.17</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.8 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.4 0.8 1</ambient>
            <diffuse>0.0 0.4 0.8 1</diffuse>
            <specular>0.0 0.4 0.8 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.8 0.08</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Prismatic joint: vertical arm → horizontal arm (slide up/down along Z) -->
      <joint name="vertical_to_horizontal" type="prismatic">
        <parent>vertical_arm</parent>
        <child>horizontal_arm</child>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit>
            <lower>-0.4</lower>
            <upper>0.4</upper>
          </limit>
        </axis>
      </joint>

      <!-- Gripper left finger -->
      <link name="gripper_left">
        <pose relative_to="horizontal_arm">0 0.425 -0.1 0 0 0</pose>
        <inertial>
          <mass>0.3</mass>
          <inertia>
            <ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.002</iyy><iyz>0</iyz>
            <izz>0.002</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.03 0.03 0.18</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.2 0.2 1</ambient>
            <diffuse>1.0 0.2 0.2 1</diffuse>
            <specular>1.0 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.03 0.03 0.18</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Gripper right finger -->
      <link name="gripper_right">
        <pose relative_to="horizontal_arm">0 0.375 -0.1 0 0 0</pose>
        <inertial>
          <mass>0.3</mass>
          <inertia>
            <ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.002</iyy><iyz>0</iyz>
            <izz>0.002</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.03 0.03 0.18</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.2 0.2 1</ambient>
            <diffuse>1.0 0.2 0.2 1</diffuse>
            <specular>1.0 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.03 0.03 0.18</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Prismatic joint: gripper left finger (open/close along Y axis) -->
      <joint name="gripper_left_joint" type="prismatic">
        <parent>horizontal_arm</parent>
        <child>gripper_left</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>0.08</upper>
          </limit>
        </axis>
      </joint>

      <!-- Prismatic joint: gripper right finger (open/close along Y axis) -->
      <joint name="gripper_right_joint" type="prismatic">
        <parent>horizontal_arm</parent>
        <child>gripper_right</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit>
            <lower>-0.08</lower>
            <upper>0.0</upper>
          </limit>
        </axis>
      </joint>

      <!-- Named feedback consumed by the ROS FSM at 100 Hz. -->
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/world/arm_world/model/two_arm_robot/joint_state</topic>
        <joint_name>vertical_to_horizontal</joint_name>
        <joint_name>gripper_left_joint</joint_name>
        <joint_name>gripper_right_joint</joint_name>
        <update_rate>100</update_rate>
      </plugin>

      <!-- Inner velocity PID; outer position PID runs in the ROS lift subsystem. -->
      <plugin filename="gz-sim-joint-controller-system"
              name="gz::sim::systems::JointController">
        <joint_name>vertical_to_horizontal</joint_name>
        <topic>/vertical_to_horizontal/cmd_vel</topic>
        <initial_velocity>0.0</initial_velocity>
        <use_force_commands>true</use_force_commands>
        <p_gain>200.0</p_gain>
        <i_gain>80.0</i_gain>
        <d_gain>0.0</d_gain>
        <i_max>100.0</i_max>
        <i_min>-100.0</i_min>
        <cmd_max>200.0</cmd_max>
        <cmd_min>-200.0</cmd_min>
        <!-- Gravity compensation: (5.0 + 0.3 + 0.3) kg * 9.81 m/s^2. -->
        <cmd_offset>54.936</cmd_offset>
      </plugin>

      <!-- Gripper left finger (prismatic, Y-axis) -->
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>gripper_left_joint</joint_name>
        <topic>/gripper_left_joint/cmd_pos</topic>
        <p_gain>120.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>12.0</d_gain>
        <cmd_max>20.0</cmd_max>
        <cmd_min>-20.0</cmd_min>
      </plugin>

      <!-- Gripper right finger (prismatic, Y-axis) -->
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>gripper_right_joint</joint_name>
        <topic>/gripper_right_joint/cmd_pos</topic>
        <p_gain>120.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>12.0</d_gain>
        <cmd_max>20.0</cmd_max>
        <cmd_min>-20.0</cmd_min>
      </plugin>

    </model>

  </world>
</sdf>